    {
      "text": "%spark.sql\nSELECT transaction_id, user_full_name, amount, currency, merchant, is_flagged_fraud, country, kafka_timestamp\nFROM delta.`s3a://staging/delta/financial_transactions`\nORDER BY kafka_timestamp DESC\nLIMIT 20;",
