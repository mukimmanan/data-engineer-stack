    {
      "text": "%spark.pyspark\nimport os\nfrom pyspark.sql.functions import col, expr\nfrom pyspark.sql.protobuf.functions import from_protobuf\n\nprint(\"Spark Version:\", spark.version)\nprint(\"Hive Metastore URI:\", spark.conf.get(\"spark.hadoop.hive.metastore.uris\", \"default\"))\nprint(\"MinIO S3A Endpoint:\", spark.conf.get(\"spark.hadoop.fs.s3a.endpoint\", \"default\"))\n\n# Ensure lakehouse database exists in Hive catalog\nspark.sql(\"CREATE DATABASE IF NOT EXISTS lakehouse\")\nprint(\"Databases in Hive Metastore:\", [db.name for db in spark.catalog.listDatabases()])",
      "user": "anonymous",
      "dateUpdated": "2026-10-11 12:46:36.100",
      "progress": 0,
