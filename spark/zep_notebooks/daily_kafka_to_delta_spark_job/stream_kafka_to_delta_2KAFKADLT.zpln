    {
      "text": "%spark.pyspark\nkafka_bootstrap_servers \u003d \"kafka-0:29092,kafka-1:29092,kafka-2:29092\"\ntopic_name \u003d \"global_financial_transactions\"\ndesc_file_path \u003d \"/notebooks/daily_kafka_to_delta_spark_job/transaction.desc\"\n\nkafka_stream \u003d (spark.readStream\n    .format(\"kafka\")\n    .option(\"kafka.bootstrap.servers\", kafka_bootstrap_servers)\n    .option(\"subscribe\", topic_name)\n    .option(\"startingOffsets\", \"earliest\")\n    .load())\n\n# Strip Confluent wire format header (1 byte magic + 4 bytes schema ID + 2 bytes index = 7 bytes)\nraw_payload_df \u003d kafka_stream.select(\n    col(\"key\").cast(\"string\").alias(\"kafka_key\"),\n    col(\"timestamp\").alias(\"kafka_timestamp\"),\n    expr(\"substring(value, 8)\").alias(\"raw_protobuf\")\n)\n\nparsed_stream_df \u003d raw_payload_df.select(\n    col(\"kafka_key\"),\n    col(\"kafka_timestamp\"),\n    from_protobuf(col(\"raw_protobuf\"), \"finance.Transaction\", descFilePath\u003ddesc_file_path, options\u003d{\"mode\": \"PERMISSIVE\"}).alias(\"payload\")\n)\n\nprint(\"Kafka Protobuf Structured Stream subscribed to topic:\", topic_name)",
      "user": "anonymous",
      "progress": 0,
